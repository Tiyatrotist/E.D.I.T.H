# ==============================================================================
# E.D.I.T.H — Environment Variables Configuration (.env)
# ==============================================================================
# Rename this file to .env and insert your private API keys.
# .env is ignored by Git and will NEVER be committed to GitHub.

# Active LLM Provider (gemini / groq / nim / mistral / cohere / openrouter / ollama)
ACTIVE_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=

# Groq Cloud API
GROQ_API_KEY=

# NVIDIA NIM API
NIM_API_KEY=

# Mistral AI API
MISTRAL_API_KEY=

# Cohere API
COHERE_API_KEY=

# OpenRouter API
OPENROUTER_API_KEY=

# OpenAI / Anthropic / DeepSeek (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Discord Bot Token (Optional)
DISCORD_BOT_TOKEN=

# External Tool APIs (Optional)
HUGGINGFACE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
